+// The IPC endpoint. On Windows this is a named pipe. The `\\?\pipe\` prefix means nothing on other
+// platforms, where net.Server.listen() reads it as a *relative* file name and creates a Unix socket
+// by that literal name in the working directory: a stray socket wherever Vortex was launched from,
+// and an outright failure when that directory is read-only -- inside a Flatpak the renderer starts
+// with cwd `/`, so listen() returns EROFS and LOOT never comes up. An absolute path in the temp
+// directory works everywhere, and both ends agree on it because the worker is forked with the same
+// environment.
+function ipcPath(id) {
+  return process.platform === 'win32'
+    ? `\\\\?\\pipe\\loot-ipc-${id}`
+    : path.join(os.tmpdir(), `loot-ipc-${id}`);
+}
