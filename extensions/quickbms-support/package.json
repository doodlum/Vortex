{
  "name": "quickbms-support",
  "version": "0.2.6",
  "description": "QuickBMS extractor support",
  "scripts": {
    "build": "node build.mjs && node download_dependencies.js && pnpm extractInfo",
    "typecheck": "pnpm tsc",
    "lint:strict": "pnpm exec node ../../scripts/strict-lint.mjs",
    "test": "pnpm exec vitest run"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "extensionName": "QuickBMS Support"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "@types/bluebird": "catalog:",
    "@types/react": "catalog:",
    "@types/redux": "catalog:",
    "bluebird": "catalog:",
    "copyfiles": "catalog:",
    "cross-fetch": "catalog:",
    "i18next": "catalog:",
    "node-7z": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api",
          "{projectRoot}/download_dependencies.js",
          "{projectRoot}/artifacts.json",
          {
            "runtime": "node -p \"process.platform + '/' + process.arch\""
          }
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
