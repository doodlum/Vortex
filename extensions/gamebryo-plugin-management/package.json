{
  "name": "gamebryo-plugin-management",
  "version": "0.5.3",
  "description": "Management for Gamebryo plugins",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./src/stylesheets/plugin_management.scss ./src/language.json ./src/loot_icon.png dist",
    "_native": "node ./copy-loot-native.mjs",
    "_build": "node build.mjs && pnpm run _assets && pnpm run _native && pnpm extractInfo",
    "build": "node -e \"if(['win32','linux'].includes(process.platform))process.exit(1)\" || (pnpm run _build)",
    "typecheck": "pnpm tsc",
    "test": "pnpm exec vitest run"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/react": "catalog:",
    "@types/react-bootstrap": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-faux-dom": "catalog:",
    "@types/react-redux": "catalog:",
    "@types/react-router": "catalog:",
    "@types/react-select": "catalog:",
    "@types/redux": "catalog:",
    "@types/redux-thunk": "catalog:",
    "bluebird": "catalog:",
    "copyfiles": "catalog:",
    "cytoscape": "catalog:",
    "cytoscape-cose-bilkent": "catalog:",
    "cytoscape-edgehandles": "catalog:",
    "date-fns": "catalog:",
    "electron": "catalog:",
    "exe-version": "workspace:*",
    "i18next": "catalog:",
    "immutability-helper": "catalog:",
    "js-yaml": "catalog:",
    "json-loader": "catalog:",
    "lodash": "catalog:",
    "markdown-ast": "catalog:",
    "memoize-one": "catalog:",
    "p-limit": "catalog:",
    "prop-types": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-dnd-html5-backend": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-markdown": "catalog:",
    "react-select": "catalog:",
    "redux": "catalog:",
    "redux-act": "catalog:",
    "redux-thunk": "catalog:",
    "reselect": "catalog:",
    "shortid": "catalog:",
    "typed-binary": "catalog:",
    "@nexusmods/vortex-api": "workspace:*"
  },
  "optionalDependencies": {
    "loot": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api",
          "stylesheets"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
